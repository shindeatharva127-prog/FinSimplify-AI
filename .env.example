# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file with real keys to version control.

# --- Required API keys ---
# Get a free NewsAPI key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Model configuration ---model="openai/gpt-oss-120b"
# The Groq model used for summarization. Change this if 
# is unavailable/deprecated on your account; see https://console.groq.com/docs/models
GROQ_MODEL=model="openai/gpt-oss-120b"
GROQ_API_BASE=https://api.groq.com/openai/v1

# --- NewsAPI configuration ---
NEWSAPI_BASE_URL=https://newsapi.org/v2

# --- App behavior ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=50
HTTP_TIMEOUT_SECONDS=12
MAX_SUMMARIZE_FIELD_LENGTH=6000

# Comma-separated list of allowed origins for CORS. Leave empty (default) to
# keep CORS disabled, which is correct when the frontend is served by this
# same FastAPI app (same-origin).
CORS_ALLOWED_ORIGINS=
