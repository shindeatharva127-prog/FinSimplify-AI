# Copy this file to ".env" and fill in real values. NEVER commit your real .env.

# Free NewsAPI key: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Change this if llama-3.3-70b-versatile is unavailable on your account
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1
NEWSAPI_BASE_URL=https://newsapi.org/v2

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=50
HTTP_TIMEOUT_SECONDS=12
MAX_SUMMARIZE_FIELD_LENGTH=6000

# Comma-separated CORS allowlist. Leave empty to keep CORS disabled (same-origin).
CORS_ALLOWED_ORIGINS=
